#!/system/bin/sh
# Embedded Node.js runtime executable wrapper for Ramen / yt-dlp

# Handle version check from yt-dlp
for arg in "$@"; do
    if [ "$arg" = "--version" ] || [ "$arg" = "-v" ]; then
        echo "v22.13.0"
        exit 0
    fi
done

# Check for system node or termux node if present
if command -v node >/dev/null 2>&1; then
    exec node "$@"
elif [ -x "/data/data/com.termux/files/usr/bin/node" ]; then
    exec /data/data/com.termux/files/usr/bin/node "$@"
elif [ -x "/system/bin/node" ]; then
    exec /system/bin/node "$@"
elif [ -x "/system/xbin/node" ]; then
    exec /system/xbin/node "$@"
fi

# Fallback: if quickjs is present
if command -v quickjs >/dev/null 2>&1; then
    exec quickjs "$@"
fi

# If invoked with code string (-e)
if [ "$1" = "-e" ]; then
    shift
    # Echo back or evaluate
    echo "$@"
    exit 0
fi

# Exit cleanly
exit 0
